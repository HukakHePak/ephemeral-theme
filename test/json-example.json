{
  "name": "ephemeral-theme",
  "displayName": "Ephemeral Theme",
  "description": "A beautiful cyberpunk-inspired dark theme",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Themes"
  ],
  "colorPalette": {
    "background": {
      "primary": "#0d0d1a",
      "secondary": "#0a0a15",
      "tertiary": "#1a0d2e"
    },
    "foreground": {
      "primary": "#e0e0ff",
      "secondary": "#9d8cc0",
      "muted": "#4a3a6b"
    },
    "accents": {
      "neonCyan": "#00ffff",
      "neonMagenta": "#ff00ff",
      "neonGreen": "#00ff88",
      "gold": "#ffd700"
    },
    "syntax": {
      "functions": "#00ffff",
      "keywords": "#ff00ff",
      "strings": "#00ff88",
      "numbers": "#ffd700",
      "comments": "#6b4a9d",
      "variables": "#e0e0ff",
      "types": "#7bb3ff"
    }
  },
  "settings": {
    "editor": {
      "fontSize": 14,
      "fontFamily": "'Fira Code', 'Courier New', monospace",
      "lineHeight": 1.6,
      "letterSpacing": 0.5
    },
    "theme": {
      "type": "dark",
      "style": "cyberpunk",
      "neonGlow": true
    }
  },
  "supportedLanguages": [
    "javascript",
    "typescript",
    "python",
    "html",
    "css",
    "json",
    "markdown",
    "java",
    "csharp",
    "cpp",
    "rust",
    "go"
  ],
  "author": {
    "name": "Your Name",
    "email": "your.email@example.com",
    "url": "https://github.com/your-username"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/ephemeral-theme.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/ephemeral-theme/issues"
  },
  "license": "MIT",
  "keywords": [
    "theme",
    "dark",
    "cyberpunk",
    "neon",
    "ephemeral",
    "cursor",
    "vscode"
  ]
}
