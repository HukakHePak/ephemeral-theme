{
  "name": "ephemeral-theme",
  "displayName": "Ephemeral Theme",
  "description": "A beautiful, ephemeral dark theme for VSCode and Cursor",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Themes"
  ],
  "icon": "resources/icon.png",
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Ephemeral",
        "uiTheme": "vs-dark",
        "path": "./themes/ephemeral-theme.json"
      },
      {
        "label": "Ephemeral Contrast",
        "uiTheme": "vs-dark",
        "path": "./themes/ephemeral-contrast-theme.json"
      }
    ],
    "configuration": {
      "title": "Ephemeral Theme",
      "properties": {
        "ephemeral-theme.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable background image for editor"
        },
        "ephemeral-theme.opacity": {
          "type": "number",
          "default": 0.05,
          "minimum": 0,
          "maximum": 1,
          "description": "Opacity of the background image"
        }
      }
    }
  },
  "publisher": "hukakhepak",
  "repository": {
    "type": "git",
    "url": "https://github.com/HukakHePak/ephemeral-theme"
  },
  "keywords": [
    "theme",
    "dark",
    "geoxor",
    "ephemeral",
    "cursor",
    "vscode"
  ],
  "license": "MIT",
  "dependencies": {
    "@vscode/sudo-prompt": "^9.3.1"
  }
}
