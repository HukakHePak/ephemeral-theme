{
  "$schema": "vscode://schemas/color-theme",
  "name": "Ephemeral",
  "type": "dark",
  "colors": {
    "editor.background": "#1a1a2e",
    "editor.foreground": "#e4e4e7",
    "editorLineNumber.foreground": "#4a5568",
    "editorLineNumber.activeForeground": "#a0aec0",
    "editor.selectionBackground": "#2d374850",
    "editor.selectionHighlightBackground": "#3b3b5c40",
    "editor.lineHighlightBackground": "#16213e",
    "editorCursor.foreground": "#00d9ff",
    "editorWhitespace.foreground": "#2d374850",
    "editorIndentGuide.background": "#2d374850",
    "editorIndentGuide.activeBackground": "#4a5568",
    "editor.findMatchBackground": "#ffd70040",
    "editor.findMatchHighlightBackground": "#ffd70020",
    "editorBracketMatch.background": "#00d9ff30",
    "editorBracketMatch.border": "#00d9ff",
    "editorWidget.background": "#16213e",
    "editorWidget.border": "#2d3748",
    "editorSuggestWidget.background": "#16213e",
    "editorSuggestWidget.border": "#2d3748",
    "editorSuggestWidget.foreground": "#e4e4e7",
    "editorSuggestWidget.highlightForeground": "#00d9ff",
    "editorSuggestWidget.selectedBackground": "#2d374850",
    "input.background": "#16213e",
    "input.border": "#2d3748",
    "input.foreground": "#e4e4e7",
    "inputOption.activeBorder": "#00d9ff",
    "dropdown.background": "#16213e",
    "dropdown.border": "#2d3748",
    "dropdown.foreground": "#e4e4e7",
    "button.background": "#00d9ff",
    "button.foreground": "#1a1a2e",
    "button.hoverBackground": "#00b8d9",
    "list.activeSelectionBackground": "#2d374850",
    "list.activeSelectionForeground": "#00d9ff",
    "list.inactiveSelectionBackground": "#2d374830",
    "list.hoverBackground": "#2d374840",
    "sideBar.background": "#0f1419",
    "sideBar.foreground": "#a0aec0",
    "sideBarTitle.foreground": "#e4e4e7",
    "sideBarSectionHeader.background": "#0f1419",
    "sideBarSectionHeader.foreground": "#00d9ff",
    "activityBar.background": "#0f1419",
    "activityBar.foreground": "#a0aec0",
    "activityBar.activeBorder": "#00d9ff",
    "activityBarBadge.background": "#00d9ff",
    "activityBarBadge.foreground": "#1a1a2e",
    "statusBar.background": "#0f1419",
    "statusBar.foreground": "#a0aec0",
    "statusBar.noFolderBackground": "#0f1419",
    "statusBar.debuggingBackground": "#00d9ff",
    "statusBar.debuggingForeground": "#1a1a2e",
    "titleBar.activeBackground": "#0f1419",
    "titleBar.activeForeground": "#e4e4e7",
    "titleBar.inactiveBackground": "#0f1419",
    "titleBar.inactiveForeground": "#4a5568",
    "tab.activeBackground": "#1a1a2e",
    "tab.activeForeground": "#e4e4e7",
    "tab.inactiveBackground": "#0f1419",
    "tab.inactiveForeground": "#4a5568",
    "tab.border": "#0f1419",
    "tab.activeBorder": "#00d9ff",
    "tab.hoverBackground": "#16213e",
    "panel.background": "#0f1419",
    "panel.border": "#2d3748",
    "panelTitle.activeForeground": "#00d9ff",
    "panelTitle.inactiveForeground": "#4a5568",
    "terminal.background": "#0f1419",
    "terminal.foreground": "#e4e4e7",
    "terminalCursor.foreground": "#00d9ff",
    "terminal.ansiBlack": "#1a1a2e",
    "terminal.ansiRed": "#ff6b6b",
    "terminal.ansiGreen": "#51cf66",
    "terminal.ansiYellow": "#ffd93d",
    "terminal.ansiBlue": "#4dabf7",
    "terminal.ansiMagenta": "#da77f2",
    "terminal.ansiCyan": "#00d9ff",
    "terminal.ansiWhite": "#e4e4e7",
    "terminal.ansiBrightBlack": "#4a5568",
    "terminal.ansiBrightRed": "#ff8787",
    "terminal.ansiBrightGreen": "#69db7c",
    "terminal.ansiBrightYellow": "#ffe066",
    "terminal.ansiBrightBlue": "#74c0fc",
    "terminal.ansiBrightMagenta": "#e599f7",
    "terminal.ansiBrightCyan": "#3bc9db",
    "terminal.ansiBrightWhite": "#f8f9fa",
    "scrollbar.shadow": "#00000050",
    "scrollbarSlider.background": "#2d374850",
    "scrollbarSlider.hoverBackground": "#2d374870",
    "scrollbarSlider.activeBackground": "#2d374890",
    "badge.background": "#00d9ff",
    "badge.foreground": "#1a1a2e",
    "progressBar.background": "#00d9ff",
    "textLink.foreground": "#00d9ff",
    "textLink.activeForeground": "#00b8d9",
    "textBlockQuote.background": "#16213e",
    "textBlockQuote.border": "#2d3748",
    "textCodeBlock.background": "#16213e",
    "textPreformat.foreground": "#00d9ff",
    "textSeparator.foreground": "#2d3748",
    "focusBorder": "#00d9ff",
    "selection.background": "#2d374850"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#4a5568",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#51cf66"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#ffd93d"
      }
    },
    {
      "name": "Built-in constant",
      "scope": [
        "constant.language",
        "constant.language.boolean",
        "constant.language.null"
      ],
      "settings": {
        "foreground": "#da77f2",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#e4e4e7"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#da77f2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Storage",
      "scope": [
        "storage.type.function",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#4dabf7"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "meta.function-call.generic",
        "support.function"
      ],
      "settings": {
        "foreground": "#00d9ff"
      }
    },
    {
      "name": "Class name",
      "scope": [
        "entity.name.class",
        "entity.name.type.class"
      ],
      "settings": {
        "foreground": "#4dabf7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Type name",
      "scope": [
        "entity.name.type",
        "support.type"
      ],
      "settings": {
        "foreground": "#4dabf7"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#ff6b6b"
      }
    },
    {
      "name": "Tag attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#ffd93d"
      }
    },
    {
      "name": "Library constant",
      "scope": [
        "support.constant"
      ],
      "settings": {
        "foreground": "#da77f2"
      }
    },
    {
      "name": "Library class/type",
      "scope": [
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#4dabf7"
      }
    },
    {
      "name": "Library function",
      "scope": [
        "support.function"
      ],
      "settings": {
        "foreground": "#00d9ff"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff6b6b",
        "background": "#ff6b6b20"
      }
    },
    {
      "name": "Markup deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#ff6b6b"
      }
    },
    {
      "name": "Markup inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#51cf66"
      }
    },
    {
      "name": "Markup changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#ffd93d"
      }
    },
    {
      "name": "Markup heading",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#00d9ff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup link",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#00d9ff",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#00d9ff",
        "background": "#16213e"
      }
    }
  ]
}
