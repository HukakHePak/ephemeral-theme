{
  "$schema": "vscode://schemas/color-theme",
  "name": "Ephemeral Contrast",
  "type": "dark",
  "colors": {
    "editor.background": "#0d0d1a",
    "editor.foreground": "#e0e0ff",
    "editorLineNumber.foreground": "#9d8cc0",
    "editorLineNumber.activeForeground": "#9d8cc0",
    "editor.selectionBackground": "#ff00ff30",
    "editor.selectionHighlightBackground": "#00ffff20",
    "editor.lineHighlightBackground": "#1a0d2e",
    "editorCursor.foreground": "#cc66ff",
    "editorWhitespace.foreground": "#2d1a4a50",
    "editorIndentGuide.background": "#2d1a4a50",
    "editorIndentGuide.activeBackground": "#6b4a9d",
    "editor.findMatchBackground": "#ff00ff40",
    "editor.findMatchHighlightBackground": "#ff00ff20",
    "editorBracketMatch.background": "#00ffff30",
    "editorBracketMatch.border": "#cc66ff",
    "editorWidget.background": "#1a0d2e",
    "editorWidget.border": "#9d8cc0",
    "editorSuggestWidget.background": "#1a0d2e",
    "editorSuggestWidget.border": "#9d8cc0",
    "editorSuggestWidget.foreground": "#e0e0ff",
    "editorSuggestWidget.highlightForeground": "#cc66ff",
    "editorSuggestWidget.selectedBackground": "#ff00ff30",
    "input.background": "#1a0d2e",
    "input.border": "#9d8cc0",
    "input.foreground": "#e0e0ff",
    "inputOption.activeBorder": "#cc66ff",
    "dropdown.background": "#1a0d2e",
    "dropdown.border": "#9d8cc0",
    "dropdown.foreground": "#e0e0ff",
    "button.background": "#cc66ff",
    "button.foreground": "#0d0d1a",
    "button.hoverBackground": "#00cccc",
    "list.activeSelectionBackground": "#ff00ff30",
    "list.activeSelectionForeground": "#cc66ff",
    "list.inactiveSelectionBackground": "#ff00ff20",
    "list.hoverBackground": "#2d1a4a40",
    "sideBar.background": "#0a0a15",
    "sideBar.border": "#9d8cc0",
    "sideBar.foreground": "#e8e8ff",
    "sideBarTitle.foreground": "#e0e0ff",
    "sideBarSectionHeader.background": "#0a0a15",
    "sideBarSectionHeader.foreground": "#cc66ff",
    "activityBar.background": "#0a0a15",
    "activityBar.foreground": "#b8a8e0",
    "activityBar.activeBorder": "#cc66ff",
    "activityBarBadge.background": "#ff00ff",
    "activityBarBadge.foreground": "#0d0d1a",
    "statusBar.background": "#0a0a15",
    "statusBar.foreground": "#b8a8e0",
    "statusBar.noFolderBackground": "#0a0a15",
    "statusBar.debuggingBackground": "#cc66ff",
    "statusBar.debuggingForeground": "#0d0d1a",
    "titleBar.activeBackground": "#0a0a15",
    "titleBar.activeForeground": "#e0e0ff",
    "titleBar.border": "#9d8cc0",
    "titleBar.inactiveBackground": "#0a0a15",
    "titleBar.inactiveForeground": "#9d8cc0",
    "tab.activeBackground": "#0d0d1a",
    "tab.activeForeground": "#e0e0ff",
    "tab.inactiveBackground": "#0a0a15",
    "tab.inactiveForeground": "#9d8cc0",
    "tab.border": "#0a0a15",
    "tab.activeBorder": "#cc66ff",
    "tab.hoverBackground": "#1a0d2e",
    "panel.background": "#0a0a15",
    "panel.border": "#9d8cc0",
    "panelTitle.activeForeground": "#cc66ff",
    "panelTitle.inactiveForeground": "#9d8cc0",
    "terminal.background": "#0a0a15",
    "terminal.foreground": "#e0e0ff",
    "terminalCursor.foreground": "#cc66ff",
    "terminal.ansiBlack": "#0d0d1a",
    "terminal.ansiRed": "#ff1493",
    "terminal.ansiGreen": "#00ff88",
    "terminal.ansiYellow": "#ffd700",
    "terminal.ansiBlue": "#4dabf7",
    "terminal.ansiMagenta": "#ff00ff",
    "terminal.ansiCyan": "#00ffff",
    "terminal.ansiWhite": "#e0e0ff",
    "terminal.ansiBrightBlack": "#4a3a6b",
    "terminal.ansiBrightRed": "#ff69b4",
    "terminal.ansiBrightGreen": "#00ffaa",
    "terminal.ansiBrightYellow": "#ffff00",
    "terminal.ansiBrightBlue": "#ff0066",
    "terminal.ansiBrightMagenta": "#ff44ff",
    "terminal.ansiBrightCyan": "#44ffff",
    "terminal.ansiBrightWhite": "#ffffff",
    "scrollbar.shadow": "#00000050",
    "scrollbarSlider.background": "#2d1a4a50",
    "scrollbarSlider.hoverBackground": "#2d1a4a70",
    "scrollbarSlider.activeBackground": "#2d1a4a90",
    "badge.background": "#ff00ff",
    "badge.foreground": "#0d0d1a",
    "progressBar.background": "#cc66ff",
    "textLink.foreground": "#cc66ff",
    "textLink.activeForeground": "#00cccc",
    "textBlockQuote.background": "#1a0d2e",
    "textBlockQuote.border": "#9d8cc0",
    "textCodeBlock.background": "#1a0d2e",
    "textPreformat.foreground": "#cc66ff",
    "textSeparator.foreground": "#9d8cc0",
    "focusBorder": "#cc66ff",
    "selection.background": "#ff00ff30",
    "breadcrumb.foreground": "#9d8cc0",
    "breadcrumb.focusForeground": "#b8a8e0",
    "breadcrumb.activeSelectionForeground": "#cc66ff",
    "breadcrumbPicker.background": "#1a0d2e",
    "editorRuler.foreground": "#2d1a4a50",
    "editorOverviewRuler.border": "#9d8cc0",
    "editorOverviewRuler.currentRangeForeground": "#00ffff40",
    "editorOverviewRuler.selectionHighlightForeground": "#ff00ff40",
    "editorOverviewRuler.wordHighlightForeground": "#00ff8840",
    "editorGroup.border": "#9d8cc0",
    "editorGroupHeader.tabsBorder": "#0a0a15",
    "editorGroupHeader.noTabsBackground": "#0a0a15",
    "editorGroupHeader.tabsBackground": "#0a0a15",
    "editorPane.background": "#0d0d1a",
    "editorWidget.resizeBorder": "#9d8cc0",
    "peekView.border": "#9d8cc0",
    "peekViewEditor.background": "#1a0d2e",
    "peekViewResult.background": "#1a0d2e",
    "peekViewTitle.background": "#0a0a15",
    "peekViewTitleLabel.foreground": "#e0e0ff",
    "peekViewTitleDescription.foreground": "#9d8cc0",
    "merge.currentHeaderBackground": "#00ffff20",
    "merge.incomingHeaderBackground": "#ff00ff20",
    "merge.commonHeaderBackground": "#4a3a6b40",
    "merge.border": "#9d8cc0",
    "editorGutter.background": "#0d0d1a",
    "editorGutter.modifiedBackground": "#ffd700",
    "editorGutter.addedBackground": "#00ff88",
    "editorGutter.deletedBackground": "#ff1493",
    "diffEditor.insertedTextBackground": "#00ff8820",
    "diffEditor.removedTextBackground": "#ff149320",
    "diffEditor.border": "#9d8cc0",
    "diffEditor.diagonalFill": "#4a3a6b40"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9d8cc0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#00ff88"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#ffd700"
      }
    },
    {
      "name": "Built-in constant",
      "scope": [
        "constant.language",
        "constant.language.boolean",
        "constant.language.null"
      ],
      "settings": {
        "foreground": "#ff00ff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#e0e0ff"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ff00ff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Storage",
      "scope": [
        "storage.type.function",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#00ffff"
      }
    },
    {
      "name": "JavaScript/TypeScript Storage (class, function keywords)",
      "scope": [
        "storage.type.class.js",
        "storage.type.class.ts",
        "storage.type.function.js",
        "storage.type.function.ts"
      ],
      "settings": {
        "foreground": "#ff6600"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "meta.function-call.generic",
        "support.function"
      ],
      "settings": {
        "foreground": "#00ffff"
      }
    },
    {
      "name": "Class name",
      "scope": [
        "entity.name.class",
        "entity.name.type.class"
      ],
      "settings": {
        "foreground": "#00ffff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Type name",
      "scope": [
        "entity.name.type",
        "support.type"
      ],
      "settings": {
        "foreground": "#ff0066"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#ff6600"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#ff6600"
      }
    },
    {
      "name": "Tag attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#ffd700"
      }
    },
    {
      "name": "Library constant",
      "scope": [
        "support.constant"
      ],
      "settings": {
        "foreground": "#ff00ff"
      }
    },
    {
      "name": "Library class/type",
      "scope": [
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#ff0066"
      }
    },
    {
      "name": "Library function",
      "scope": [
        "support.function"
      ],
      "settings": {
        "foreground": "#00ffff"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff1493",
        "background": "#ff149320"
      }
    },
    {
      "name": "Markup deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#ff1493"
      }
    },
    {
      "name": "Markup inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#00ff88"
      }
    },
    {
      "name": "Markup changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#ffd700"
      }
    },
    {
      "name": "Markup heading",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#cc66ff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup link",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#cc66ff",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#cc66ff",
        "background": "#1a0d2e"
      }
    }
  ]
}
